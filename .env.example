# Copy this file to ".env" and fill in your values.
# Anything prefixed with EXPO_PUBLIC_ is inlined into the app bundle at build time.

# OpenAI API key used for Whisper speech-to-text (Voice mode).
# Get one at https://platform.openai.com/api-keys
# Leave blank to disable transcription (Voice mode will show a clear "not configured" error).
EXPO_PUBLIC_OPENAI_API_KEY=

# How long (ms) the interface waits for the logic layer to write a matching output
# entry before giving up and showing a timeout error. PRD §6.4 suggests 15000-20000.
EXPO_PUBLIC_RESPONSE_TIMEOUT_MS=18000

# Dev-only convenience: when "true", the interface auto-writes a fake "done" output
# entry a moment after each input so the whole flow is demoable on its own, before the
# Swift logic layer exists (PRD Acceptance Criteria, final bullet). Set to "false"
# (or toggle it off in Settings) once the real logic layer is writing outputs.
EXPO_PUBLIC_DEV_ECHO=true
